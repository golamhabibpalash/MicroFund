# =============================================================================
# Unity MicroFund — Runtime Secrets TEMPLATE
# =============================================================================
# This is the reference for the server-only file `/root/.unitymicrofund`.
# That file is the SINGLE SOURCE OF TRUTH for all live configuration
# (database, JWT, Google login, SMTP email). It is NOT committed to git.
#
# Why this exists:
#   The CI/CD pipeline (.github/workflows/deploy.yml) runs `update.sh` on every
#   push to main. `update.sh` regenerates appsettings.Production.json and the
#   Angular environment by SOURCING `/root/.unitymicrofund`. Because the live
#   secrets live in this file (outside git), a code push can NEVER overwrite
#   your Google login or email config.
#
# First-time setup is automatic: `deploy.sh` writes `/root/.unitymicrofund`
# from its CONFIGURATION section (and never overwrites it if it already exists).
# Use this template only if you need to create or audit the file by hand.
#
# To create/edit manually on the server:
#   sudo nano /root/.unitymicrofund      # paste the keys below, fill real values
#   sudo chmod 600 /root/.unitymicrofund
#   sudo bash /var/www/unitymicrofund/repo/update.sh   # apply the new values
#
# IMPORTANT: GOOGLE_CLIENT_ID must be IDENTICAL on backend and frontend (the
# backend validates the Google token audience against it), and the production
# domain must be an Authorized JavaScript origin in Google Cloud Console.
# =============================================================================

DOMAIN="app.unitymicrofund.com"

DB_NAME="microfundDb"
DB_USER="microfund"
DB_PASS="YOUR_DB_PASSWORD"

JWT_SECRET="YOUR_RANDOM_SECRET_AT_LEAST_32_CHARS"

GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USERNAME="YOUR_SMTP_USERNAME"
EMAIL_PASSWORD="YOUR_SMTP_APP_PASSWORD"
EMAIL_FROM="noreply@yourdomain.com"
